  "constitution": "Ozzmosis/docs/Vault/Raw/CEO-AGENT-STRATEGIC-ALIGNMENT.md",
  "spec_canonical_path": "AuroraOS/factory/ceo-agent/ceo-agent.json",
  "output_vault_internal": "AuroraOS/factory/ceo-agent/vault/",
  "output_vault_projects": "AuroraOS/projects/"
