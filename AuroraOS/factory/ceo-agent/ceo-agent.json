{
  "agent_id": "ceo-agent-v1",
  "name": "CEO Agent",
  "version": "1.0.0",
  "domain": "SOVEREIGN",
  "project_id": "CEO-SOVEREIGN",
  "capabilities": [
    "STRATEGIC_PLANNING",
    "BACKLOG_PRIORITIZATION",
    "INTEGRITY_AUDIT"
