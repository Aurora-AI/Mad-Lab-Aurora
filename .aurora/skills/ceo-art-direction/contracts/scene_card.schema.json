{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneCard",
  "type": "object",
  "properties": {
    "scene_name": { "type": "string" },
    "narrative_function": { "type": "string" },
    "visual_world": { "type": "string" },
    "atmosphere": { "type": "string" },
    "camera": {
      "type": "object",
      "properties": {
        "lens": { "type": "string" },
        "movement": { "type": "string" }
      },
      "required": ["lens", "movement"]
    },
    "lighting": { "type": "string" },
    "matter": { "type": "string" },
    "texture": { "type": "string" },
    "central_symbol": { "type": "string" },
    "visual_tension": { "type": "string" },
    "permitted_movement": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prohibited_movement": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_asset": { "type": "string" },
    "fallback": { "type": "string" },
    "rejection_criteria": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "scene_name",
    "narrative_function",
    "visual_world",
    "atmosphere",
    "camera",
    "lighting",
    "matter",
    "texture",
    "central_symbol",
    "visual_tension",
    "permitted_movement",
    "prohibited_movement",
    "required_asset",
    "fallback",
    "rejection_criteria"
  ]
}
