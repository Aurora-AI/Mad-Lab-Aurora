{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aurora Vault Thread",
  "description": "Transcrição estruturada de sessão operacional entre Comandante e agentes. Append-only.",
  "type": "object",
  "required": ["thread_id", "title", "date", "participants", "status", "decisions", "os_generated", "messages"],
  "properties": {
    "thread_id": {
      "type": "string",
      "description": "Formato: {YYYY-MM-DD}-{slug}",
      "example": "2026-04-18-mad-lab-asset-library"
    },
    "title": {
      "type": "string",
      "description": "Nome descritivo da sessão"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "integer",
      "description": "Duração total estimada da sessão"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["comandante", "arquiteto", "processador", "executor"] },
          "agent": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "abandoned"]
    },
    "context": {
      "type": "string",
      "description": "Parágrafo de contexto: por que esta sessão existiu"
    },
    "decisions": {
      "type": "array",
      "description": "Decisões tomadas durante a sessão — indexáveis",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "alternatives_rejected": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "os_generated": {
      "type": "array",
      "description": "IDs das OSes geradas nesta sessão",
      "items": { "type": "string" }
    },
    "vault_artifacts": {
      "type": "array",
      "description": "Artefatos persistidos no Vault como resultado desta sessão"
    },
    "token_ledger_ref": {
      "type": "string",
      "description": "Path para o ledger desta sessão em Token-Ledger/"
    },
    "messages": {
      "type": "array",
      "description": "Mensagens da sessão (resumidas, não verbatim)",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string", "enum": ["comandante", "arquiteto", "processador"] },
          "summary": { "type": "string", "description": "Resumo da mensagem — não transcrição literal" },
          "type": {
            "type": "string",
            "enum": ["instrução", "análise", "decisão", "os-gerada", "gate-verificado", "questão", "aprovação"]
          },
          "timestamp": { "type": "string", "format": "time" },
          "os_ref": { "type": "string", "description": "OS gerada nesta mensagem, se houver" }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "achievements": { "type": "array", "items": { "type": "string" } },
        "pending": { "type": "array", "items": { "type": "string" } },
        "next_session_context": { "type": "string" }
      }
    }
  }
}
