{
  // Exclude compiled/dist artifacts from all analysis tools (securecoder, eslint, search).
  // These files are generated by Vite and contain minified third-party library code
  // (React internals, React Router, etc.) that triggers false-positive CWE warnings
  // which cannot be remediated since they are not our source code.
  "files.exclude": {
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true
  },

  // TypeScript / language server
  "typescript.tsdk": "aurora-web/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Securecoder: restrict scanning to source files only
  "securecoder.exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.min.js",
    "**/build/**"
  ],

  // Securecoder: disable i18n enforcement rules.
  // This is an internal single-tenant governance tool — internationalization is
  // explicitly out of scope. The jsx-i18n rule generates false positives on:
  //   - Material Symbols icon identifiers (close, done_all, lens_blur, arrow_upward, edit)
  //   - Internal technical labels (WRITE INTENT, JSON Mirror, REF // OS-CRM-...)
  //   - Single-language operational UI labels (Reviewed by, Timestamp, etc.)
  "securecoder.rules": {
    "jsx-i18n": "off",
    "no-hardcoded-string": "off"
  }
}
