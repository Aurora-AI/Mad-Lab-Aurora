# Public client-side Gemini key used by the institutional assistant.
# Replace with a real key in local development and configure the same
# variable in Vercel project settings for production.
VITE_GEMINI_API_KEY="COLE_SUA_CHAVE_GEMINI_AQUI"

# Gemini model used by the assistant widget.
VITE_GEMINI_MODEL="gemini-3-flash-preview"

# Public app URL for local references and future callbacks.
APP_URL="http://localhost:3000"
