{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aurora Token Ledger Monthly Summary",
  "type": "object",
  "required": ["month", "total_tokens", "total_cost_usd", "total_cost_brl", "by_agent", "by_os"],
  "properties": {
    "month": {
      "type": "string",
      "description": "Formato YYYY-MM",
      "example": "2026-04"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_tokens": {
      "type": "integer"
    },
    "total_cost_usd": {
      "type": "number"
    },
    "total_cost_brl": {
      "type": "number",
      "description": "Inclui majoração fiscal BR ~1.4x sobre USD"
    },
    "budget_alert": {
      "type": "boolean",
      "description": "true se algum agent ultrapassou 80% do budget configurado"
    },
    "by_agent": {
      "type": "object",
      "description": "Custo e tokens agrupados por agente",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tokens": { "type": "integer" },
          "cost_usd": { "type": "number" },
          "os_count": { "type": "integer" }
        }
      }
    },
    "by_model": {
      "type": "object",
      "description": "Custo e tokens agrupados por modelo LLM"
    },
    "by_os": {
      "type": "array",
      "description": "Lista de OSes com custo total por OS",
      "items": {
        "type": "object",
        "properties": {
          "os_id": { "type": "string" },
          "total_tokens": { "type": "integer" },
          "total_cost_usd": { "type": "number" },
          "steps": { "type": "integer" }
        }
      }
    },
    "top_cost_steps": {
      "type": "array",
      "description": "Top 5 steps mais caros do mês",
      "maxItems": 5
    },
    "optimization_notes": {
      "type": "array",
      "description": "Observações automáticas sobre oportunidades de otimização"
    }
  }
}
